{%- comment -%} Noble Misfit — "Not for occasions" cards (Figma 1:926) {%- endcomment -%}
<section class="noble-occasions bg-noble-bg py-16 md:py-[6.4rem]">
  <div class="mx-auto mb-[5.2rem] flex max-w-canvas flex-col items-center gap-3 px-5 text-center" data-noble-reveal>
    {%- if section.settings.heading != blank -%}
      <h2 class="m-0 font-display text-[clamp(3rem,4.5vw,5.2rem)] leading-[1.1] text-noble-ink">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.heading_italic != blank -%}
      <h2 class="m-0 font-serifit text-[clamp(3rem,4.5vw,5.2rem)] italic leading-[1.1] text-noble-ink">{{ section.settings.heading_italic }}</h2>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p class="mt-4 max-w-[58rem] font-gill text-[1.6rem] font-light text-noble-slate">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>

  <div class="noble-grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" data-noble-reveal-group="110">
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="noble-occasions__card group relative block overflow-hidden bg-noble-cream aspect-[4/5] lg:aspect-[333.5/444.66]"
        data-noble-reveal
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 800 | image_tag: class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105', loading: 'lazy', widths: '400,600,800' }}
        {%- elsif block.settings.default_asset != blank -%}
          <img src="{{ block.settings.default_asset | asset_url }}" alt="{{ block.settings.title | escape }}" width="668" height="890" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
        {%- endif -%}
        <span class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.65));"></span>
        <span class="absolute inset-x-0 bottom-0 z-[1] flex flex-col gap-[0.7rem] p-[2.7rem]">
          <span class="m-0 font-display text-[2.8rem] leading-none text-noble-offwhite">{{ block.settings.title }}</span>
          <span class="m-0 max-w-[27rem] font-gill text-[1.6rem] font-light leading-[1.35] text-[rgba(248,242,229,0.82)]">{{ block.settings.text }}</span>
          {%- if block.settings.link_label != blank -%}
            <span class="mt-[0.6rem] inline-block self-start border-b border-noble-gold-light pb-[0.45rem] font-gill text-[1.2rem] font-semibold uppercase tracking-[0.2rem] text-noble-offwhite opacity-100 transition-all duration-300 lg:opacity-0 lg:translate-y-2 lg:group-hover:opacity-100 lg:group-hover:translate-y-0">
              {{ block.settings.link_label }}
            </span>
          {%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>

  {%- if section.settings.cta_label != blank -%}
    <div class="mt-[4.8rem] flex justify-center" data-noble-reveal>
      <a href="{{ section.settings.cta_link | default: '#' }}" class="inline-block border-b border-solid border-noble-gold-light pb-[0.5rem] font-gill text-[1.2rem] font-semibold uppercase tracking-[0.2rem] text-noble-ink transition-colors hover:text-noble-terracotta">
        {{ section.settings.cta_label }}
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Noble Occasions",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading line 1", "default": "Not for occasions." },
    { "type": "text", "id": "heading_italic", "label": "Heading line 2 (italic)", "default": "For the everyday." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Four situations. One capsule. Built to mix with what you already own." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop the collection" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Occasion card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Work" },
        { "type": "text", "id": "text", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "default_asset", "label": "Fallback asset filename" },
        { "type": "text", "id": "link_label", "label": "Hover link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Noble Occasions",
      "blocks": [
        { "type": "card", "settings": { "title": "Work", "text": "Structured silhouettes. Craft as detail, not statement.", "default_asset": "noble-occasion-work.png" } },
        { "type": "card", "settings": { "title": "Brunch", "text": "Relaxed but considered. Print-forward. Loafers or sandals.", "default_asset": "noble-occasion-brunch.png", "link_label": "Shop the look →" } },
        { "type": "card", "settings": { "title": "Evening", "text": "Drapey, moody, heirloom energy. The Ajrakh story does the work.", "default_asset": "noble-occasion-evening.png" } },
        { "type": "card", "settings": { "title": "Date Night", "text": "Deep neckline. Colour that reads in low light. Prints that tell the story.", "default_asset": "noble-occasion-datenight.png" } }
      ]
    }
  ]
}
{% endschema %}

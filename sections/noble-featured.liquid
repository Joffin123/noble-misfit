{%- comment -%}
  Noble Misfit — Featured Pieces (Figma 1:643 / 1:653)
  Uses a real collection when one is selected; otherwise renders the
  default capsule cards from the design.
{%- endcomment -%}
<section class="noble-featured bg-noble-bg py-16 md:py-[6.4rem]">
  <div class="mx-auto max-w-canvas px-5 md:px-8 lg:px-20">
    <div class="mb-[4.4rem] flex flex-wrap items-end justify-between gap-6">
      <div class="flex max-w-[56rem] flex-col gap-[1.4rem]">
        {%- if section.settings.heading != blank -%}
          <h2 class="m-0 font-display text-[clamp(3rem,4vw,4.6rem)] leading-[1.1] text-noble-ink">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="m-0 font-gill text-[1.6rem] font-light leading-[1.4] text-noble-slate">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url | default: '#' }}" class="inline-block whitespace-nowrap border-b border-noble-gold-light pb-[0.5rem] font-gill text-[1.2rem] font-semibold uppercase tracking-[0.2rem] text-noble-ink transition-colors hover:text-noble-terracotta">
          {{ section.settings.link_label }} →
        </a>
      {%- endif -%}
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-4">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: 4 -%}
          <a href="{{ product.url }}" class="group flex flex-col gap-[1.8rem] no-underline">
            <span class="relative block overflow-hidden bg-noble-cream aspect-[301/434.66]">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 700 | image_tag: class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105', loading: 'lazy', widths: '300,500,700' }}
              {%- endif -%}
              {%- if product.available == false -%}
                <span class="absolute left-[1.7rem] top-[1.7rem] z-[1] bg-noble-ink px-[0.9rem] py-[0.5rem] font-sans text-[0.9rem] font-bold uppercase tracking-[0.162rem] text-noble-offwhite">Sold out</span>
              {%- elsif product.tags contains 'new' -%}
                <span class="absolute left-[1.7rem] top-[1.7rem] z-[1] bg-noble-terracotta px-[0.9rem] py-[0.5rem] font-sans text-[0.9rem] font-bold uppercase tracking-[0.162rem] text-noble-offwhite">New</span>
              {%- endif -%}
            </span>
            <span class="flex flex-col gap-[0.5rem]">
              {%- if product.type != blank -%}
                <span class="font-gill text-[1rem] font-semibold uppercase tracking-[0.2rem] text-noble-terracotta">{{ product.type }}</span>
              {%- endif -%}
              <span class="m-0 font-display text-[1.8rem] capitalize leading-[1.15] text-noble-ink">{{ product.title }}</span>
              <span class="font-gill text-[1.4rem] text-noble-ink">{{ product.price | money }}</span>
            </span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="group flex flex-col gap-[1.8rem] no-underline" {{ block.shopify_attributes }}>
            <span class="relative block overflow-hidden bg-noble-cream aspect-[301/434.66]">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 700 | image_tag: class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105', loading: 'lazy', widths: '300,500,700' }}
              {%- elsif block.settings.default_asset != blank -%}
                <img src="{{ block.settings.default_asset | asset_url }}" alt="{{ block.settings.title | escape }}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
              {%- endif -%}
              {%- if block.settings.badge != blank -%}
                <span class="absolute left-[1.7rem] top-[1.7rem] z-[1] px-[0.9rem] py-[0.5rem] font-sans text-[0.9rem] font-bold uppercase tracking-[0.162rem] text-noble-offwhite {% if block.settings.badge_style == 'new' %}bg-noble-terracotta{% else %}bg-noble-green-soft{% endif %}">{{ block.settings.badge }}</span>
              {%- endif -%}
            </span>
            <span class="flex flex-col gap-[0.5rem]">
              {%- if block.settings.craft != blank -%}
                <span class="font-gill text-[1rem] font-semibold uppercase tracking-[0.2rem] text-noble-terracotta">{{ block.settings.craft }}</span>
              {%- endif -%}
              <span class="m-0 font-display text-[1.8rem] capitalize leading-[1.15] text-noble-ink">{{ block.settings.title }}</span>
              <span class="font-gill text-[1.4rem] text-noble-ink">{{ block.settings.price }}</span>
            </span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Noble Featured",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Pieces" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Hand-picked from the soft-launch capsule. Each carries a number, a craft, and the hours behind it." },
    { "type": "text", "id": "link_label", "label": "View-all label", "default": "Shop all styles" },
    { "type": "url", "id": "link_url", "label": "View-all link" },
    { "type": "collection", "id": "collection", "label": "Collection (live products)", "info": "When set, real products replace the default cards." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Default card",
      "settings": [
        { "type": "text", "id": "craft", "label": "Craft / origin", "default": "Sanganeri · Jaipur" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sanganeri crop shirt + shorts" },
        { "type": "text", "id": "price", "label": "Price", "default": "$445 CAD" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "default_asset", "label": "Fallback asset filename" },
        { "type": "text", "id": "badge", "label": "Badge text" },
        { "type": "select", "id": "badge_style", "label": "Badge style", "options": [ { "value": "default", "label": "Green" }, { "value": "new", "label": "Terracotta (New)" } ], "default": "default" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Noble Featured",
      "blocks": [
        { "type": "product", "settings": { "craft": "Sanganeri · Jaipur", "title": "Sanganeri crop shirt + shorts", "price": "$445 CAD", "default_asset": "noble-product-sanganeri.png", "badge": "Bestseller", "badge_style": "default" } },
        { "type": "product", "settings": { "craft": "Ajrakh motif · Kutch", "title": "Indigo vest + wide-leg co-ord", "price": "$565 CAD", "default_asset": "noble-product-indigo.png" } },
        { "type": "product", "settings": { "craft": "Jamdani · West Bengal", "title": "Jamdani burgundy midi skirt", "price": "$310 CAD", "default_asset": "noble-product-jamdani.png", "badge": "New", "badge_style": "new" } },
        { "type": "product", "settings": { "craft": "Ikat · Pochampally", "title": "Ikat mini skirt", "price": "$295 CAD", "default_asset": "noble-product-ikat.png" } }
      ]
    }
  ]
}
{% endschema %}
